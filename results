. * 2. 定义体量权重构建程序 (已经完美替换为你的中文变量名 经度 和 纬度)
. capture program drop mk_mass_weight

. program define mk_mass_weight
  1.     args core_code core_name core_gdp core_lat core_lng
  2.     
.     * 计算地理距离 (直接使用 纬度 和 经度)
.     tempvar dist geo_w
  3.     gen double `dist' = 6371 * acos(sin(纬度*_pi/180)*sin(`core_lat'*_pi/180) + ///
>                         cos(纬度*_pi/180)*cos(`core_lat'*_pi/180)*cos((经度-`core_lng')*_pi/180))
  4.     replace `dist' = 0 if 代码 == `core_code'
  5.     gen double `geo_w' = 1 / (`dist' + 1)
  6.     
.     * 计算绝对体量权重 (核心：吸收方体量 / 发射方体量)
.     tempvar eco_w
  7.     gen double `eco_w' = 1 / ((local_gdp / `core_gdp') + 1)
  8.     
.     * 生成综合体量嵌套权重
.     capture drop W_Mass_`core_name'
  9.     gen double W_Mass_`core_name' = `geo_w' * `eco_w'
 10.     
.     * 方向约束：核心不对自己辐射
.     replace W_Mass_`core_name' = 0 if 代码 == `core_code'
 11. end

